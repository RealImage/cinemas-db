# Postgres container (docker-compose.yml)
POSTGRES_USER=cineams
POSTGRES_PASSWORD=cineams
POSTGRES_DB=cineams
POSTGRES_PORT=5432

# Used by db/migrate.ts and db/seed.ts
DATABASE_URL=postgres://cineams:cineams@localhost:5432/cineams
API_PORT=3001

# Encrypts masked credential values (32 bytes, base64): openssl rand -base64 32
# Unset in development uses a built-in dev key; required when NODE_ENV=production.
# Changing it makes existing masked values unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# Locations Reference sync (server/locations/sync.ts): nightly at this hour, server time.
# LOCATION_SYNC_SCHEDULE=off disables the nightly run (Run now still works).
LOCATION_SYNC_HOUR=2
LOCATION_SYNC_SCHEDULE=
